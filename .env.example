# Copy to .env.local for local dev, and set the same values in Vercel
# (Project Settings -> Environment Variables).

# Supabase (Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key — server-side only, NEVER expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe (Dashboard -> Developers -> API keys / Products)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
# Webhook signing secret for /api/stripe-webhook (Developers -> Webhooks)
STRIPE_WEBHOOK_SECRET=

# AI voice dialer (Vapi — https://vapi.ai)
# Create an assistant + phone number in the Vapi dashboard, then set:
VAPI_API_KEY=
VAPI_ASSISTANT_ID=
VAPI_PHONE_NUMBER_ID=
# Shared secret appended to the Vapi server webhook URL (?secret=...)
VOICE_WEBHOOK_SECRET=

# Public URL of the deployed app, used for Stripe success/cancel redirects
NEXT_PUBLIC_APP_URL=https://wholesale-os-amber.vercel.app
